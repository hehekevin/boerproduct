{
  "version": "clean2table-r4",
  "note": "示意模板（非正式答案）。按实际 case.json 的列名/单位改写 condition 与 action；规则可增删可改优先级，改完重跑 clean_run.py run 即可。",
  "contract_keys": ["case_id", "status", "result", "claims", "uncertainties"],
  "field_dictionary": {
    "substance": {"aliases": ["adsorbate", "solute", "analyte", "compound", "污染物", "吸附质", "物质"], "type": "string", "desc": "物质/分析物归一名"},
    "metric": {"aliases": ["indicator", "parameter", "field_name", "指标", "参数"], "type": "string", "desc": "指标归一名（长表时即字段名列）"},
    "value": {"aliases": ["q", "capacity", "result", "val", "数值"], "type": "number|interval|string-with-unit", "desc": "数值（可含单位串，原值永不删除）"},
    "unit": {"aliases": ["units", "单位"], "type": "string", "desc": "单位（长表时单列；宽表时常嵌在值串里）"},
    "condition": {"aliases": ["conditions", "实验条件", "pH", "temperature", "context"], "type": "string", "desc": "条件上下文，参与重复判定键，不同条件不错并"},
    "source": {"aliases": ["source_id", "paper", "文献", "study_id"], "type": "string", "desc": "来源文献/实验标识，参与条件指纹"}
  },
  "conflict_policy": {
    "value_ratio_threshold": 2.0,
    "merge_value_tolerance": 1e-6,
    "action": "register_only",
    "note": "同键异值或同指标异源差异只登记进 result.conflicts + uncertainties.human_review，不裁决；字面换算不能替代科学冲突裁决"
  },
  "rules": [
    {"rule_id": "FM01", "kind": "field_mapping", "priority": 10,
     "condition": {"column": "adsorbate"},
     "action": {"target_field": "substance"},
     "rationale": "同义列名→规范字段（依据：字段字典 aliases）", "on_fail": "列不存在则跳过不报错"},
    {"rule_id": "FM02", "kind": "field_mapping", "priority": 11,
     "condition": {"column": "q_exp"},
     "action": {"target_field": "value"},
     "rationale": "拆分/别名列→value", "on_fail": "同上"},
    {"rule_id": "FM03", "kind": "field_mapping", "priority": 12,
     "condition": {"column": "field_name"},
     "action": {"target_field": "metric"},
     "rationale": "长表指标列→metric", "on_fail": "同上"},
    {"rule_id": "UC01", "kind": "unit_convert", "priority": 20,
     "condition": {"field": "value", "from_unit": "ug/g"},
     "action": {"to_unit": "mg/g", "precision": 4},
     "rationale": "1 ug/g = 0.001 mg/g（数量级前缀，见 units-table.md）；引擎自动产出 trace 中间值留痕（前后缀因子/net_factor/前后值/recompute），可复算", "on_fail": "解析失败/基准不同→原值保留并进 pending_review，且逐条登记 uncertainties.dirty_values"},
    {"rule_id": "UC02", "kind": "unit_convert", "priority": 21,
     "condition": {"field": "value", "from_unit": "mg/L"},
     "action": {"to_unit": "g/L", "precision": 6},
     "rationale": "1 mg/L = 0.001 g/L", "on_fail": "同上"},
    {"rule_id": "UC03", "kind": "unit_convert", "priority": 22,
     "condition": {"field": "value", "from_unit": "ug/L"},
     "action": {"to_unit": "mg/L", "precision": 4, "factor": 0.001, "offset": 0},
     "rationale": "规则显式给 factor（也可用于 ppm≈mg/kg 等须显式声明的近似换算）；factor_source=rule 一样进 trace", "on_fail": "同上"},
    {"rule_id": "SN01", "kind": "synonym_norm", "priority": 30,
     "condition": {"field": "substance"},
     "action": {"groups": [
        {"canonical": "Pb2+", "members": ["Pb(II)", "lead ion", "Pb+2", "铅离子"]},
        {"canonical": "Cd2+", "members": ["Cd(II)", "cadmium ion", "镉离子"]}]},
     "rationale": "同义写法归一到允许值集合", "on_fail": "成员跨组→登记 synonym_conflict，不归一"},
    {"rule_id": "SN02", "kind": "synonym_norm", "priority": 31,
     "condition": {"field": "metric"},
     "action": {"groups": [
        {"canonical": "adsorption_capacity", "members": ["q_e", "qe", "capacity", "吸附量"]}]},
     "rationale": "指标名归一", "on_fail": "同上"},
    {"rule_id": "MM01", "kind": "missing_mark", "priority": 40,
     "condition": {"fields": ["value", "unit", "condition"]},
     "action": {"keep": "empty", "missing_tokens": ["ND", "N/A", "-", "—", "null", "未报告", "unknown"]},
     "rationale": "缺失保持空缺，绝不编造；记号→空缺属值变更，进 changelog 并内嵌行级 ledger", "on_fail": "无"},
    {"rule_id": "AF01", "kind": "anomaly_flag", "priority": 50,
     "condition": {"field": "value", "min": 0},
     "action": {"on_violation": "flag_keep_value", "note": "负值越界"},
     "rationale": "越界只标记不改值（改值需人工）", "on_fail": "无"},
    {"rule_id": "DD01", "kind": "dedup", "priority": 60,
     "condition": {"key_fields": ["substance", "metric"],
                    "context_fields": ["condition", "source", "experiment_id"]},
     "action": {"on_exact_key": "merge_keep_first", "on_partial_key": "no_merge_register",
                "link_field": ""},
     "rationale": "判定键=归一物质+归一指标+条件指纹；键全同且值相容→重复记录合并；条件指纹不同→重复实验绝不合并并逐条登记 dirty_values；值不一致→冲突登记不合并。link_field 可指向组织方给出的重复身份列（如 duplicate_of）",
     "on_fail": "键字段缺失→跳过该行去重并记录"}
  ]
}
